          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onChoice2:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 758784936}
        m_TargetAssemblyTypeName: Talk, Assembly-CSharp
        m_MethodName: Say
        m_Mode: 1
        m_Arguments:
