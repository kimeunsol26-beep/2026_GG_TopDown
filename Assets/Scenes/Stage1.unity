--- !u!114 &1888052514
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1888052513}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 405f13f10d21d4447b72ae71fa6e0394, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uCD0C\uC7A5"
    text: "\uC548\uB155\uD558\uC2DC\uAC8C\uB098 \uC0C8\uB85C\uC6B4 \uC0AC\uB78C\uC778\uAC00?"
    portrait: {fileID: 3058686582840955661, guid: 303968713cf5aa442a353f36e9608b07, type: 3}
  - speaker: "\uB098"
    text: "\uC608 \uB9DE\uC2B5\uB2C8\uB2E4. \uB9C8\uB140\uB2D8\uC758 \uC624\uB450\uB9C9
      \uC870\uC218\uC785\uB2C8\uB2E4."
    portrait: {fileID: 0}
  - speaker: "\uCD0C\uC7A5"
    text: "\uC544\uC544 \uADF8 \uB9C8\uB140\uC778\uAC00..."
    portrait: {fileID: 3058686582840955661, guid: 303968713cf5aa442a353f36e9608b07, type: 3}
  - speaker: "\uB098"
    text: "\uB124?"
    portrait: {fileID: 0}
  - speaker: "\uCD0C\uC7A5"
    text: "\uC5B4\uCA0B\uB4E0 \uBB34\uC2A8\uC77C\uC778\uAC00? \uC774\uC0AC\uC628\uC9C0\uB294
      \uC880 \uB41C \uBAA8\uC591\uC778\uB370...\uC9D1\uBC16\uC73C\uB85C \uB098\uC624\uB2E4\uB2C8
      \uC758\uC678\uC778\uB370 \uB9D0\uC77C\uC138? "
    portrait: {fileID: 3058686582840955661, guid: 303968713cf5aa442a353f36e9608b07, type: 3}
  - speaker: "\uB098"
    text: "\uC544\uC544..\uADF8\uAC8C  "
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "(\uC5B4\uCA4C\uC9C0? \uC0AC\uC2E4\uB300\uB85C \uB9D0\uD558\uAE30\uC5D4...) "
    portrait: {fileID: 0}
  - speaker: "\uCD0C\uC7A5"
    text: "\uC2EC\uBD80\uB984\uC774\uB77C\uB3C4 \uAC00\uB294\uAC90\uAC00? "
    portrait: {fileID: 3058686582840955661, guid: 303968713cf5aa442a353f36e9608b07, type: 3}
  - speaker: "\uB098"
    text: "(\uC774\uAC70\uB2E4..!) \uB124! \uC232\uC73C\uB85C \uAC00\uC57C\uD558\uB294\uB370,
      \uC5B4\uB518\uC9C0 \uC544\uC2DC\uB098\uC694? "
    portrait: {fileID: 0}
  - speaker: "\uCD0C\uC7A5"
    text: "\uC2AC\uB77C\uC784 \uC232\uC774 \uB9C8\uC744\uBC16\uC5D0 \uC788\uAE34\uD558\uB124\uB9CC...\uC9C0\uB3C4\uB294
      \uC904 \uC218 \uC5C6\uB2E4\uB124! "
    portrait: {fileID: 3058686582840955661, guid: 303968713cf5aa442a353f36e9608b07, type: 3}
  - speaker: "\uB098"
    text: "...\uC5B4\uC9F8\uC11C\uC8E0?"
    portrait: {fileID: 0}
  - speaker: "\uCD0C\uC7A5"
    text: "\uC704\uD5D8\uD558\uB2C8 \uB9D0\uC77C\uC138. \uB0B4 \uC9D1\uC5D0 \uC9C0\uB3C4\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uAE34\uD558\uB2E4\uB9CC...\uADF8\uAC74 \uCD0C\uC7A5\uC5D0\uAC8C\uB9CC
      \uC8FC\uC5B4\uC9C0\uB294 \uAC83\uC778\uC9C0\uB77C,"
    portrait: {fileID: 3058686582840955661, guid: 303968713cf5aa442a353f36e9608b07, type: 3}
  - speaker: "\uB098"
    text: "(\uC9D1\uC774\uB780\uB9D0\uC774\uC9C0?)"
    portrait: {fileID: 0}
  choice1: "\uCD0C\uC7A5 \uC9D1\uC5D0 \uAC00\uBCF4\uC790"
  choice2: "\uADF8\uB798\uB3C4 \uD6D4\uCE58\uB294 \uAC74 \uC880."
  onChoice1:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 689928866}
        m_TargetAssemblyTypeName: Talk, Assembly-CSharp
        m_MethodName: Say
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
