  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 405f13f10d21d4447b72ae71fa6e0394, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB9C8\uB140"
    text: "\uC548\uB155 \uC870\uC218~"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC800\uB294 \uC77C\uB2E8 \uC5D8\uB9AC\uC2A4\uC778\uB370\uC694 \uB9C8\uB140\uB2D8..."
    portrait: {fileID: 0}
  - speaker: "\uB9C8\uB140"
    text: "\uB098\uC5D0\uAC8C \uADF8\uAC74 \uC911\uC694\uD558\uC9C0\uC54A\uC544~\uC790
      \uB0B4\uAC00 \uAC14\uB2E4\uC62C\uB3D9\uC548 \uC774 \uC9D1 \uC815\uB9AC\uB97C
      \uBD80\uD0C1\uD560\uAC8C"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uB124?\uAC11\uC790\uAE30\uC694?? "
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "(\uC774 \uB9C8\uB140\uB2D8\uC740 \uB3C4\uB300\uCCB4 \uC65C \uADF8\uB7EC\uB294\uAC70\uC9C0..)"
    portrait: {fileID: 0}
  - speaker: "\uB9C8\uB140"
    text: "\uADF8\uB798 \uC774\uBC88 \uB9C8\uC744\uC5D0\uC11C\uB3C4 \uC798\uC9C0\uB0B4\uC57C\uC9C0~
      \uBB3C\uC57D\uBCD1 \uC548\uAE68\uC9C0\uAC8C \uC870\uC2EC\uD558\uACE0 \uC5EC\uAE30
      \uC5F4\uC1E0, \uC815\uB9AC \uBD80\uD0C1\uD574~\t "
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "(\uB9CC\uB2A5 \uC5F4\uC1E0\uB97C \uC8FC\uC168\uB124..?) "
    portrait: {fileID: 0}
  choice1: "\uB124, \uC54C\uACA0\uC2B5\uB2C8\uB2E4"
  choice2: "\uC2EB\uC5B4\uC694 \uB9C8\uB140\uB2D8"
  onChoice1:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 572374213}
