  lines:
  - speaker: 
    text: "\uC0C1\uC790\uB2E4"
    portrait: {fileID: 0}
  - speaker: 
    text: "\uC548\uC5D0 \uBB3C\uC57D\uBCD1\uC774 \uAC00\uB4DD \uCC28\uC788\uB2E4.
      \uC870\uC2EC\uD788 \uC62E\uACA8\uC57C..."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC820\uC7A5 \uAE68\uB728\uB838\uC5B4"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC77C\uB2E8...\uC218\uC2B5\uD574\uC57C\uD574."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC7AC\uB8CC\uB97C \uAD6C\uD574\uBCF4\uC790!"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC7AC\uB8CC\uAC00...\uBD89\uC740 \uC0C9 \uBC84\uC12F\uC774\uB07C, \uC2AC\uB77C\uC784\uC9C4\uC561,
      \uB2EC\uBE5B\uC218\uC815?"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC820\uC7A5 \uC77C\uB2E8...\uB9C8\uC744\uC5D0 \uAC00\uBCF4\uC790"
    portrait: {fileID: 0}
