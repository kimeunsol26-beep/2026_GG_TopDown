  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uCD0C\uC7A5"
    text: "\uC548\uB155\uD558\uC2DC\uAC8C\uB098 \uC0C8\uB85C\uC6B4 \uC0AC\uB78C\uC778\uAC00?"
  - speaker: "\uB098"
    text: "\uC800\uB294 \uAE38\uC744 \uC783\uC5C8\uB294\uB370\uC694"
  - speaker: "\uCD0C\uC7A5"
    text: "\uD760.. \uB098\uB97C \uB3C4\uC640\uC900\uB2E4\uBA74 \uAE38\uC744 \uC54C\uB824\uC8FC\uACA0\uB124."
  - speaker: "\uB098"
    text: "\uB124?\uAC11\uC790\uAE30\uC694?"
  - speaker: "\uCD0C\uC7A5"
    text: "\uB0B4 \uC9D1\uC5D0 \uC0C1\uC790\uB4E4\uC911 \uC5F4\uC1E0\uB97C \uCC3E\uC544\uC8FC\uAC8C\uB098. "
  - speaker: "\uB098"
    text: "(\uB0B4 \uB9D0\uC740 \uB4E4\uB9AC\uC9C0\uC54A\uB294\uAC74\uAC00..?\uC77C\uB2E8
      \uAC00\uBCF4\uC790) "
  prompt: {fileID: 118468618}
  dialogueBox: {fileID: 194219495}
